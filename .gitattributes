# Normalise every text file to LF in the repository.  The project is authored
# on Windows but must check out identically on Linux/macOS and in CI.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary

# The single-file bundle is generated by tools/build.mjs — keep it out of the
# language statistics and out of diff noise.
neon-drift-86.html  linguist-generated=true -diff
